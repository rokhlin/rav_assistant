# ==========================================
# Настройки Telegram бота
# ==========================================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Безопасность: список Telegram ID пользователей через запятую (например: 12345678,87654321)
# Если пусто — бот доступен всем, кто ему напишет.
ALLOWED_USER_IDS=

# ==========================================
# Настройки AI провайдера ("gemini" или "openai")
# ==========================================
AI_PROVIDER=gemini

# Google Gemini (Рекомендуется: очень быстрый, доступный, встроенный OCR и поддержка аудио/документов)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# OpenAI (Альтернатива)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_WHISPER_MODEL=whisper-1

# ==========================================
# Настройки поведения бота
# ==========================================
# Действие по умолчанию при отправке фото или документа без выбора кнопки ("analyze" или "translate")
DEFAULT_ACTION=analyze

# Язык перевода
TARGET_LANGUAGE=Русский

# Часовой пояс контейнера
TZ=Europe/Moscow

# ==========================================
# Пути монтирования на хосте ZimaOS / ZimaBoard
# ==========================================
# Локальные папки на сервере ZimaOS (например: /DATA/AppData/helper_translater/... или относительные пути)
HOST_CONFIG_PATH=./data/config
HOST_CLOUD_PATH=./data/cloud
HOST_NOTES_PATH=./data/notes

# Внутренние пути контейнера (обычно менять не требуется)
STORAGE_CLOUD_PATH=/app/data/cloud
STORAGE_NOTES_PATH=/app/data/notes
